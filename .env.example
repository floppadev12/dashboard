# Copy to .env.local for local testing. On Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit real values: this repo is public.

# Database (optional but recommended, so games and settings sync between devices)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_ops_dashboard?schema=public"

# Real revenue: one API key with universe-analytics → universe.analytics:read,
# with all your games selected
ROBLOX_API_KEY=
# Or one key per game instead: {"universeId":"key","universeId2":"key2"}
ROBLOX_API_KEYS=

# Password for the dashboard (any username works)
DASHBOARD_PASSWORD=

# Daily Discord report
DISCORD_WEBHOOK_URL=
CRON_SECRET=
DASHBOARD_URL=
# Only needed if you don't use a database: comma-separated universe IDs for reports
ROBLOX_UNIVERSE_IDS=

# Optional /revenue command
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
